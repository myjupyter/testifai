{
  "name": "testifai-js",
  "version": "0.1.0",
  "description": "CLI tool for generating tests from comments in TypeScript and JavaScript code",
  "type": "module",
  "bin": {
    "testifai": "bin/testifai.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "run:bin": "NODE_ENV=development node bin/testifai.mjs",
    "format": "prettier  --write --cache",
    "typecheck": "tsc --pretty",
    "lint": "eslint ",
    "fix:js": "eslint  --fix",
    "fix": "npm run fix:js && npm run format",
    "changeset": "changeset version && node .changeset/rewrite-changelog.mjs CHANGELOG.md",
    "release": "changeset publish",
    "test": "NODE_ENV=development vitest run",
    "test:watch": "NODE_ENV=development vitest"
  },
  "keywords": [
    "testing",
    "typescript",
    "javascript",
    "test-generation",
    "cli"
  ],
  "dependencies": {
    "dotenv": "^17.2.3",
    "ky": "^1.7.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.38.0",
    "@types/node": "^24.9.1",
    "@typescript-eslint/typescript-estree": "^8.46.2",
    "eslint": "^9.38.0",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "vitest": "^4.0.3"
  }
}
