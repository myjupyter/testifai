{
  "name": "testifai-cli",
  "version": "0.1.0",
  "description": "CLI tool for generating tests from comments in TypeScript and JavaScript code",
  "type": "module",
  "bin": {
    "testifai": "./bin/testifai.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "format": "prettier . --write --cache",
    "typecheck": "tsc --pretty",
    "lint": "eslint .",
    "fix:js": "eslint . --fix",
    "fix": "npm run fix:js && npm run format",
    "prepare": "husky",
    "changeset": "changeset version && node .changeset/rewrite-changelog.mjs CHANGELOG.md",
    "release": "changeset publish",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "testing",
    "typescript",
    "javascript",
    "test-generation",
    "cli"
  ],
  "dependencies": {},
  "devDependencies": {
    "@changesets/cli": "^2.29.7",
    "@changesets/get-github-info": "^0.6.0",
    "@eslint/js": "^9.39.0",
    "@types/node": "^24.9.1",
    "@typescript-eslint/typescript-estree": "^8.46.2",
    "eslint": "^9.38.0",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.6",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "vitest": "^4.0.3"
  },
  "lint-staged": {
    "*.{js,mjs}": "eslint --cache --fix",
    "*.{js,json,md,mjs,ts,yml}": "prettier --write"
  }
}
