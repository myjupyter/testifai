{
    "provider": {
        "openai": {
            "apiKey": "<YOUR_OPENAI_API_KEY>"
        }
    },
    "output": {
        "testDir": null,
        "extension": ".spec"
    },
    "scan": {
        "include": ["**/*.ts", "**/*.js"],
        "exclude": ["node_modules/**", "**/*.spec.*", "**/*.test.*"]
    }
}
